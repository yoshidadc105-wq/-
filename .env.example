# ===== テスト時は TEST 用 LINE チャンネルの値を入れる =====
# ===== 本番移行時は本番の値に差し替える =================

# LINE Messaging API チャンネルシークレット
LINE_CHANNEL_SECRET=ここにChannel_Secretを貼る

# LINE Messaging API チャンネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=ここにAccess_Tokenを貼る

# Stransa の Webhook URL（本番移行時のみ設定。テスト時は空でOK）
STRANSA_WEBHOOK_URL=https://line-backend.stransa.co.jp/v1/line-message/70f88cc018f36a290eb74daec8905e55

# 問診表のURL（このサーバーのURL + /form.html）
# 例: https://xxxx.onrender.com/form.html
QUESTIONNAIRE_URL=https://xxxx.onrender.com/form.html

# テストモード: true にすると Stransa への転送をスキップする
TEST_MODE=true

# 問診表の回答を受け取るメールアドレス
MAIL_TO=yoshidadc105@gmail.com

# Resend APIキー（resend.com で取得）
RESEND_API_KEY=ここにResendのAPIキーを貼る

# PrintNode APIキー（printnode.com で取得）
PRINTNODE_API_KEY=ここにAPIキーを貼る

# PrintNode プリンターID（PrintNode管理画面の「デバイス」で確認）
PRINTNODE_PRINTER_ID=75390062

# 管理画面のパスワード
ADMIN_PASSWORD=ここにパスワードを設定する

# Googleスプレッドシート連携（任意）
# スプレッドシートURLの /d/XXXXXX/edit の XXXXXX 部分
GOOGLE_SPREADSHEET_ID=
# サービスアカウントのJSONキー（1行に圧縮したもの）
GOOGLE_SERVICE_ACCOUNT_KEY=

# サーバーポート（Renderなどは自動設定されるため通常変更不要）
PORT=3000
